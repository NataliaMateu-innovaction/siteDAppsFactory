---
import Eyebrow from '../Eyebrow.astro';
import { cases } from '../../data/site';
---

<section id="casos" class="cases section is-dark" aria-labelledby="casos-h2">
  <div class="container">
    <div class="cases__head" data-reveal>
      <Eyebrow label="Dónde se aplica" center />
      <h2 id="casos-h2" class="h2">Cuatro problemas que resolvemos.</h2>
    </div>
    <div class="cases__list">
      {cases.map((c) => (
        <a href="/contacto/" class="case-row" data-reveal>
          <span class="case-row__n">{c.n}</span>
          <h3 class="h3 case-row__t">{c.title}</h3>
          <p class="body case-row__d">{c.text}</p>
          <span class="case-row__arrow" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4M12 4H6M12 4v6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
          <span class="case-row__line" aria-hidden="true"></span>
        </a>
      ))}
    </div>
  </div>
</section>
