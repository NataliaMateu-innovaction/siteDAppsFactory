---
import { faq, faqs, faqVisible } from '../../data/site';

// Datos estructurados FAQPage: Google y los asistentes de IA leen las
// preguntas y respuestas directamente de acá. Incluye también las plegadas:
// están en la página, solo que detrás de "Ver más preguntas".
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});

const first = faqs.slice(0, faqVisible);
const rest = faqs.slice(faqVisible);
---

<section class="faq section is-light" aria-labelledby="faq-h2">
  <div class="container">
    <h2 id="faq-h2" class="h2 faq__h2" data-reveal>{faq.title}</h2>
    <div class="faq__list">
      {[first, rest].map((group, g) => (
        <div class:list={{ faq__more: g === 1 }} id={g === 1 ? 'faq-more' : undefined} hidden={g === 1 || undefined}>
          {group.map((f, j) => {
            const i = g === 0 ? j : faqVisible + j;
            return (
              <div class="faq-item">
                <button
                  type="button"
                  class="faq-item__btn"
                  id={`faq-btn-${i}`}
                  data-faq-toggle
                  aria-expanded="false"
                  aria-controls={`faq-panel-${i}`}
                >
                  <span class="faq-item__q">{f.q}</span>
                  <span class="faq-item__icon" aria-hidden="true"></span>
                </button>
                <div class="faq-item__panel" id={`faq-panel-${i}`} role="region" aria-labelledby={`faq-btn-${i}`}>
                  <div>
                    <p class="lead faq-item__a">{f.a}</p>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      ))}
      {rest.length > 0 && (
        <button type="button" class="faq__toggle tlink" data-faq-more aria-expanded="false" aria-controls="faq-more">
          <span data-faq-more-label>Ver más preguntas ({rest.length})</span>
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 3v10M8 13l-4-4M8 13l4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      )}
    </div>
  </div>
  <script type="application/ld+json" set:html={jsonLd} />
</section>
