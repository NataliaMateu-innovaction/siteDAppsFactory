---
/*
  Medición: los mismos tres que tenía el sitio anterior (dappsfactory.io).
  Los IDs están en src/data/site.ts → `analytics`; vaciar uno lo desactiva.

  Solo se cargan en el build de producción: en `npm run dev` no se ejecutan,
  así las pruebas locales no cuentan como visitas.
*/
import { analytics } from '../data/site';

interface Props {
  /** 'head' son los scripts; 'body' es el <noscript> de GTM, que va apenas abre el body.
      No se llama `slot` porque ese atributo está reservado en Astro. */
  position?: 'head' | 'body';
}
const { position = 'head' } = Astro.props;
const on = import.meta.env.PROD;
const { ga4, gtm, metaPixel } = analytics;
---

{on && position === 'head' && (
  <>
    {ga4 && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}></script>
        <script is:inline define:vars={{ ga4 }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', ga4);
        </script>
      </>
    )}

    {gtm && (
      <script is:inline define:vars={{ gtm }}>
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', gtm);
      </script>
    )}

    {metaPixel && (
      <>
        <script is:inline define:vars={{ metaPixel }}>
          !(function (f, b, e, v, n, t, s) {
            if (f.fbq) return;
            n = f.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); };
            if (!f._fbq) f._fbq = n;
            n.push = n; n.loaded = !0; n.version = '2.0'; n.queue = [];
            t = b.createElement(e); t.async = !0; t.src = v;
            s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t, s);
          })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', metaPixel);
          fbq('track', 'PageView');
        </script>
        <noscript>
          <img height="1" width="1" style="display:none" alt="" src={`https://www.facebook.com/tr?id=${metaPixel}&ev=PageView&noscript=1`} />
        </noscript>
      </>
    )}
  </>
)}

{on && position === 'body' && gtm && (
  <noscript>
    <iframe src={`https://www.googletagmanager.com/ns.html?id=${gtm}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe>
  </noscript>
)}
