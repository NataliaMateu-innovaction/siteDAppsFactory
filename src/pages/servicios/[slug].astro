---
/*
  Landing de servicio. El contenido viene de src/data/servicios.ts; acá solo
  está la estructura. Las secciones se renderizan en el orden declarado y el
  fondo alterna claro/oscuro (empieza claro, después del hero oscuro), salvo
  que la sección fije `theme`.
*/
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Faq from '../../components/sections/Faq.astro';
import Cta from '../../components/sections/Cta.astro';
import { serviceLandings } from '../../data/servicios';
import { agendaHref } from '../../data/site';

export function getStaticPaths() {
  return serviceLandings.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const arrow = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12L12 4M12 4H6M12 4v6" stroke="#060607" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const themeOf = (i: number, forced?: 'light' | 'dark') => forced ?? (i % 2 === 0 ? 'light' : 'dark');
const nn = (i: number) => String(i + 1).padStart(2, '0');
const leads = (l?: string | string[]) => (l ? (Array.isArray(l) ? l : [l]) : []);
// Imágenes de hero: se resuelven acá para que Astro las optimice (AVIF/WebP).
const heroImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/servicios/*.{png,jpg,jpeg,webp}', { eager: true });
const heroImage = s.hero.image ? heroImages['../../assets/servicios/' + s.hero.image]?.default : undefined;
---

<Base title={s.seoTitle} description={s.seoDescription}>
  <header class:list={['page-head page-head--service is-dark', { 'page-head--with-image': heroImage }]}>
    <div class:list={['container service-hero', { 'service-hero--split': heroImage }]}>
      <div class="service-hero__text">
        <Eyebrow label={s.hero.eyebrow} />
        <h1 class="page-head__h1">{s.hero.title}</h1>
        {s.hero.paragraphs.map((p, i) => (
          <p class:list={['lead', 'page-head__lead', { 'service-hero__p2': i > 0 }]}>{p}</p>
        ))}
        <a href={agendaHref} class="btn-primary service-hero__cta" data-magnetic>
          {s.hero.cta}
          <Fragment set:html={arrow} />
        </a>
      </div>
      {heroImage && (
        <div class="service-hero__media">
          <Picture
            src={heroImage}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[560, 1120]}
            sizes="(min-width: 1025px) 560px, (min-width: 641px) 70vw, calc(100vw - 40px)"
            alt={s.hero.imageAlt ?? ''}
            loading="eager"
          />
        </div>
      )}
    </div>
  </header>

  {s.sections.map((sec, i) => {
    const theme = themeOf(i, sec.theme);
    const id = `sec-${i}`;
    return (
      <section class:list={['svc-sec', 'section', `svc-sec--${sec.type}`, `is-${theme}`]} aria-labelledby={id}>
        {sec.type === 'plans' && (
          <div class="container">
            <div class="svc-sec__head" data-reveal>
              <h2 id={id} class="h2">{sec.title}</h2>
              {leads(sec.lead).map((l) => <p class="lead svc-sec__lead">{l}</p>)}
            </div>
            <div class="plans__grid">
              {sec.items.map((p, j) => (
                <article class:list={['plan', { 'plan--featured is-dark': p.featured }]} data-reveal data-delay={j ? 120 : undefined}>
                  <div class="plan__eyebrow">{p.eyebrow}</div>
                  <h3 class="h3 plan__title">{p.title}</h3>
                  <p class="body plan__text">{p.text}</p>
                  <div class="plan__label">Puede incluir</div>
                  <ul class="check-list">{p.includes.map((it) => <li>{it}</li>)}</ul>
                  <p class="plan__ideal">{p.ideal}</p>
                </article>
              ))}
            </div>
            {sec.cta && (
              <div class="svc-sec__cta" data-reveal>
                <a href={agendaHref} class="btn-primary" data-magnetic>{sec.cta}<Fragment set:html={arrow} /></a>
              </div>
            )}
          </div>
        )}

        {sec.type === 'features' && (
          <div class="container">
            <div class="svc-sec__head" data-reveal>
              <h2 id={id} class="h2">{sec.title}</h2>
              {leads(sec.lead).map((l) => <p class="lead svc-sec__lead">{l}</p>)}
            </div>
            <div class="features__box" data-reveal>
              <div class="plan__label">{sec.label ?? 'Puede incluir'}</div>
              <ul class="check-list check-list--cols">{sec.includes.map((it) => <li>{it}</li>)}</ul>
              {sec.closing && <p class="features__closing">{sec.closing}</p>}
            </div>
          </div>
        )}

        {sec.type === 'grid' && (
          <div class="container">
            <div class="svc-sec__head" data-reveal>
              <h2 id={id} class="h2">{sec.title}</h2>
              {leads(sec.lead).map((l) => <p class="lead svc-sec__lead">{l}</p>)}
            </div>
            <div class="igrid__grid">
              {sec.items.map((it, j) => (
                <div class="igrid__item" data-reveal data-delay={[0, 120, 240][j % 3] || undefined}>
                  <span class="igrid__n">{nn(j)}</span>
                  <h3 class="h3 igrid__title">{it.title}</h3>
                  <p class="body igrid__text">{it.text}</p>
                </div>
              ))}
            </div>
          </div>
        )}

        {sec.type === 'steps' && (
          <div class="container split">
            <div class="split__head" data-reveal>
              <h2 id={id} class="h2 steps__h2">{sec.title}</h2>
              {sec.lead && <p class="lead steps__lead">{sec.lead}</p>}
            </div>
            <ol class="steps__list">
              {sec.items.map((st, j) => (
                <li class="step" data-reveal>
                  <span class="step__n gradient-text">{nn(j)}</span>
                  <div>
                    <h3 class="h3 step__title">{st.title}</h3>
                    <p class="body step__text">{st.text}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        )}

        {sec.type === 'text' && (
          <div class="container split">
            <div class="split__head" data-reveal>
              <h2 id={id} class="h2 text__h2">{sec.title}</h2>
            </div>
            <div class="text__body" data-reveal data-delay="120">
              {sec.paragraphs.map((p, j) => (
                <p class:list={['lead', { 'text__last': !sec.tagline && !sec.flow && j === sec.paragraphs.length - 1 }]}>{p}</p>
              ))}
              {sec.tagline && <p class="text__tagline">{sec.tagline}</p>}
              {sec.flow && (
                <ol class="flow" aria-label="Flujo">
                  {sec.flow.map((f, j) => (
                    <li>
                      <span class="flow__item">{f}</span>
                      {j < sec.flow!.length - 1 && <span class="flow__arrow" aria-hidden="true">→</span>}
                    </li>
                  ))}
                </ol>
              )}
            </div>
          </div>
        )}

        {sec.type === 'infra' && (
          <div class:list={['container', { 'infra__inner': !sec.items }]} data-reveal>
            <div class:list={['svc-sec__head', { 'infra__center': !sec.items }]}>
              <h2 id={id} class="h2">{sec.title}</h2>
              {sec.text && <p class="lead svc-sec__lead">{sec.text}</p>}
            </div>
            {sec.tags && <ul class="infra__tags" aria-label="Características">{sec.tags.map((t) => <li>{t}</li>)}</ul>}
            {sec.items && (
              <div class="infra__grid">
                {sec.items.map((it, j) => (
                  <div class="infra__item" data-reveal data-delay={[0, 120, 240][j % 3] || undefined}>
                    <h3 class="h3 infra__title">{it.title}</h3>
                    <p class="body infra__text">{it.text}</p>
                  </div>
                ))}
              </div>
            )}
          </div>
        )}
      </section>
    );
  })}

  <Cta title={s.cta.title} text={s.cta.text} label={s.cta.label} />

  <Faq items={s.faqs} title="Preguntas frecuentes" visible={s.faqs.length} />
</Base>
