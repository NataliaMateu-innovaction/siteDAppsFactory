---
import { getCollection } from 'astro:content';
import Inner from '../../layouts/Inner.astro';

const posts = (await getCollection('blog', ({ data }) => !data.borrador))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('es-AR', { day: '2-digit', month: 'long', year: 'numeric' });
---

<Inner
  title="Blog · DAppsFactory"
  description="Notas técnicas sobre tokenización, wallets, desarrollo blockchain y regulación, escritas por el equipo que construye la infraestructura."
  eyebrow="Blog"
  h1="Lo que aprendimos poniendo esto en producción."
  bajada="Notas técnicas y regulatorias del equipo. Sin humo: lo que funcionó, lo que no, y por qué."
>
  <section style="background:var(--bg-light); color:var(--text-on-light); padding:clamp(64px,8vw,110px) 0 clamp(96px,12vw,140px);">
    <div style="max-width:1280px; margin:0 auto; padding:0 clamp(20px,5vw,40px);">
      {posts.length === 0 ? (
        <p style="margin:0; font-size:1rem; line-height:1.62; color:var(--muted-on-light);">
          Todavía no hay notas publicadas.
        </p>
      ) : (
        <div style="border-top:1px solid var(--hairline-light);">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}/`}
              data-row="1"
              style="position:relative; display:grid; grid-template-columns:1fr; gap:8px 24px; align-items:start; padding:clamp(24px,3vw,36px) clamp(12px,2vw,20px); border-bottom:1px solid var(--hairline-light); transition:background 250ms ease;"
            >
              <span style="font-family:var(--font-display); font-size:0.8125rem; font-weight:600; letter-spacing:0.14em; color:var(--muted-on-light);">
                {post.data.tema}
              </span>
              <h2
                data-rowtitle="1"
                style="margin:0; font-family:var(--font-display); font-weight:600; font-size:clamp(1.25rem,2vw,1.6rem); line-height:1.2; letter-spacing:-0.02em; transition:transform 250ms cubic-bezier(0.22,1,0.36,1);"
              >{post.data.titulo}</h2>
              <p style="margin:0; font-size:1rem; line-height:1.62; color:var(--muted-on-light); max-width:56ch; text-wrap:pretty;">
                {post.data.bajada}
                <span style="display:block; margin-top:8px; font-size:0.8125rem;">
                  {fmt(post.data.fecha)} · {post.data.autor}
                </span>
              </p>
              <span data-rowarrow="1" aria-hidden="true" style="display:none; justify-self:end; align-self:center; transition:transform 250ms cubic-bezier(0.22,1,0.36,1);">
                <svg width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4M12 4H6M12 4v6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span data-rowline="1" aria-hidden="true" style="position:absolute; left:0; bottom:-1px; width:100%; height:1px; background:var(--brand-gradient); transform:scaleX(0); transform-origin:left; transition:transform 350ms cubic-bezier(0.22,1,0.36,1);"></span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Inner>
