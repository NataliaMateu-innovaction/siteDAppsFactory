---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Inner from '../../layouts/Inner.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
import { fechaCorta as fmt } from '../../utils/date';
const [featured, ...rest] = posts;
---

<Inner
  title="Blog · DAppsFactory"
  description="Tokenización de activos, ERC-3643, wallets fiat + cripto y regulación blockchain en Argentina y Latinoamérica, explicados para quien tiene que decidir."
  eyebrow="Blog"
  h1="Lo que aprendemos poniendo blockchain en producción."
  lead="Tokenización, ERC-3643, wallets fiat + cripto y regulación en Argentina y Latinoamérica, escrito para quien tiene que decidir."
>
  <section class="blog section is-light">
    <div class="container">
      {posts.length === 0 && <p class="lead">Estamos preparando las primeras notas.</p>}

      {featured && (
        <a href={`/blog/${featured.id}/`} class="post-card post-card--featured" data-reveal>
          <div class="post-card__tile">
            {featured.data.cover ? (
              <Picture src={featured.data.cover} formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 1280]} sizes="(min-width: 900px) 60vw, calc(100vw - 40px)" alt="" loading="eager" />
            ) : (
              <span class="post-card__tile-line" aria-hidden="true"></span>
            )}
          </div>
          <div class="post-card__body">
            <div class="post-card__meta">
              <time datetime={featured.data.pubDate.toISOString()}>{fmt(featured.data.pubDate)}</time>
              <span class="post-card__meta-sep" aria-hidden="true">·</span>
              <span>{featured.data.author}</span>
            </div>
            <h2 class="h2 post-card__title">{featured.data.title}</h2>
            <p class="lead post-card__desc">{featured.data.description}</p>
            <span class="tlink">Leer la nota
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7" /><path d="M7 7h10v10" /></svg>
            </span>
          </div>
        </a>
      )}

      <div class="blog__grid">
        {rest.map((post, i) => (
          <a href={`/blog/${post.id}/`} class="post-card" data-reveal data-delay={[0, 120, 240][i % 3] || undefined}>
            <div class="post-card__tile">
              {post.data.cover ? (
                <Picture src={post.data.cover} formats={['avif', 'webp']} fallbackFormat="webp" widths={[420, 840]} sizes="(min-width: 1025px) 400px, (min-width: 641px) 50vw, calc(100vw - 40px)" alt="" loading="lazy" />
              ) : (
                <span class="post-card__tile-line" aria-hidden="true"></span>
              )}
            </div>
            <div class="post-card__body">
              <div class="post-card__meta">
                <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                <span class="post-card__meta-sep" aria-hidden="true">·</span>
                <span>{post.data.author}</span>
              </div>
              <h2 class="h3 post-card__title">{post.data.title}</h2>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Inner>
