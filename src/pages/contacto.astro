---
/*
  Contacto: el formulario es el del CRM (LeadConnector / GoHighLevel), el mismo
  que usaba el sitio anterior, embebido en iframe. El ID vive en site.ts.
*/
import Inner from '../layouts/Inner.astro';
import { contact } from '../data/site';
const formId = contact.crmFormId;
---

<Inner
  title="Contacto · DAppsFactory"
  description="Agendá 30 minutos con un especialista de DAppsFactory. Contanos qué querés poner en producción: tokenización de activos, wallets fiat + cripto o desarrollo blockchain."
  eyebrow="Contacto"
  h1="Contanos qué querés poner en producción."
  lead="30 minutos con alguien que ya construyó esto. Sin pitch de ventas. Dejanos tus datos y te escribimos para coordinar."
>
  <section class="contact section is-dark">
    <div class="container contact__grid">
      <div class="contact__form" data-reveal>
        {formId ? (
          <>
            <iframe
              src={`https://api.leadconnectorhq.com/widget/form/${formId}`}
              id={`inline-${formId}`}
              class="contact__iframe"
              data-layout="{'id':'INLINE'}"
              data-trigger-type="alwaysShow"
              data-trigger-value=""
              data-activation-type="alwaysActivated"
              data-activation-value=""
              data-deactivation-type="neverDeactivate"
              data-deactivation-value=""
              data-form-name="Form Contacto Web DappsFactory"
              data-height="583"
              data-layout-iframe-id={`inline-${formId}`}
              data-form-id={formId}
              title="Formulario de contacto"
            ></iframe>
            <script is:inline src="https://link.msgsndr.com/js/form_embed.js"></script>
          </>
        ) : (
          <p class="lead">Escribinos a <a href={`mailto:${contact.email}`}>{contact.email}</a>.</p>
        )}
      </div>

      <aside class="contact__aside" data-reveal data-delay="120">
        <div class="contact__block">
          <div class="footer__title">Directo</div>
          <div class="contact__links">
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
            <a href={contact.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a>
            <a href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a href={contact.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
          </div>
        </div>
        <div class="contact__block">
          <div class="footer__title">Qué pasa después</div>
          <ol class="contact__steps">
            <li>Te respondemos en el día hábil siguiente.</li>
            <li>Una llamada de 30 minutos para entender el caso, el activo y la jurisdicción.</li>
            <li>Si tiene sentido, un documento con arquitectura y alcance. Si no, te lo decimos.</li>
          </ol>
        </div>
      </aside>
    </div>
  </section>
</Inner>
